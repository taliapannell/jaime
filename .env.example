# Copy to .env (git-ignored) and fill in ONE provider. Restart `npm run dev` after editing.

# Recipes (Claude). Without it the demo falls back to hardcoded recipes.
ANTHROPIC_API_KEY=

# Images: fill in ONE provider below. Without one the UI falls back to procedural art.

# Option A: OpenAI
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# Option B: Azure OpenAI (takes precedence if all three are set)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_IMAGE_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Production (npm start): set the same vars as platform secrets. Optional:
# PORT=8080
