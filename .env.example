# Copy to .env (git-ignored) and fill in ONE provider. Restart `npm run dev` after editing.

# Recipes (Claude on Amazon Bedrock). No key needed: uses your AWS login locally and the
# server's IAM role in production (that role needs Bedrock access to Claude Opus 5.5).
# If AWS isn't reachable, the demo falls back to hardcoded recipes.
# BEDROCK_REGION=us-east-1

# Images: set ONE provider below, or leave all unset to use Stability AI on Amazon Bedrock
# via the same AWS credentials (the IAM role needs Bedrock access to the model below).
# BEDROCK_IMAGE_MODEL=stability.stable-image-core-v1:1
# BEDROCK_IMAGE_REGION=us-west-2
# If the image call fails, the UI falls back to procedural art.

# Option A: OpenAI
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# Option B: Azure OpenAI (takes precedence if all three are set)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_IMAGE_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Production (npm start): set the same vars as platform secrets. Optional:
# PORT=8080
